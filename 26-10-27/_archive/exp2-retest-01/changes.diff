+def source_fidelity_gate(c, device, v, source_screen, work):
+    """Optional exact-RGB source gate, before assistant invocation; never a brightness heuristic."""
+    options=c.raw.get('source_fidelity_gate')
+    if not options:return None
+    from PIL import Image,ImageChops
+    roi=tuple(options['roi']);required=int(options.get('required_consecutive',2));maximum=int(options.get('max_checks',16))
+    require(len(roi)==4 and 0<=roi[0]<roi[2]<=c.image_size[0] and 0<=roi[1]<roi[3]<=c.image_size[1], 'Invalid source fidelity ROI')
+    require(required>=2 and maximum>=required,'Source fidelity needs at least two matching observations')
+    expected=Image.open(c.image(v)).convert('RGB').crop(roi);require(expected.getbbox() is not None,'Source ROI contains no target pixels')
+    folder=work/'source-fidelity';folder.mkdir();history=[];consecutive=0
+    for index in range(maximum):
+        device.check_component(c.raw['gallery_component'])
+        if index:
+            time.sleep(float(options.get('poll_s',2)));device.shot(source_screen)
+        actual=Image.open(source_screen).convert('RGB').crop(roi);difference=ImageChops.difference(expected,actual);exact=difference.getbbox() is None
+        snapshot=folder/f'{index+1:02d}.png';shutil.copy2(source_screen,snapshot)
+        history.append(dict(index=index+1,exact=exact,source_screen_sha256=file_hash(snapshot),max_abs_difference=max(x[1] for x in difference.getextrema())))
+        consecutive=consecutive+1 if exact else 0
+        result=dict(status='PASS' if consecutive>=required else 'WAITING',roi=list(roi),expected_roi_sha256=digest(expected.tobytes()),observed_roi_sha256=digest(actual.tobytes()),consecutive_exact=consecutive,observations=history)
+        save_json(work/'source-fidelity.json',result)
+        if consecutive>=required:return result
+    result['status']='FAIL';save_json(work/'source-fidelity.json',result)
+    raise PipelineError('Source-screen RGB differs from original PNG; stopped before assistant invocation/submission')
+
